<mujoco model="six_link_arm">
  <compiler angle="degree"/>
  <option timestep="0.01"/>
  <asset>
    <texture name="texgrid" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.2 0.2 0.2" width="512" height="512"/>
    <material name="mat" texture="texgrid" texrepeat="1 1"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" pos="0 0 0" size="10 10 0.1" material="mat"/>
    <body name="base" pos="0 0 0.1">
      <!-- Link 1 -->
      <body name="link1" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0" range="-180 180"/>
        <geom name="geom1" type="capsule" fromto="0 0 0 0 0 0.2" size="0.03"/>
        <!-- Link 2 -->
        <body name="link2" pos="0 0 0.2">
          <joint name="joint2" type="hinge" axis="0 1 0" pos="0 0 0" range="-180 180"/>
          <geom name="geom2" type="capsule" fromto="0 0 0 0 0 0.2" size="0.03"/>
          <!-- Link 3 -->
          <body name="link3" pos="0 0 0.2">
            <joint name="joint3" type="hinge" axis="0 0 1" pos="0 0 0" range="-180 180"/>
            <geom name="geom3" type="capsule" fromto="0 0 0 0 0 0.18" size="0.03"/>
            <!-- Link 4 -->
            <body name="link4" pos="0 0 0.18">
              <joint name="joint4" type="hinge" axis="0 1 0" pos="0 0 0" range="-180 180"/>
              <geom name="geom4" type="capsule" fromto="0 0 0 0 0 0.15" size="0.03"/>
              <!-- Link 5 -->
              <body name="link5" pos="0 0 0.15">
                <joint name="joint5" type="hinge" axis="0 0 1" pos="0 0 0" range="-180 180"/>
                <geom name="geom5" type="capsule" fromto="0 0 0 0 0 0.12" size="0.03"/>
                <!-- Link 6 -->
                <body name="link6" pos="0 0 0.12">
                  <joint name="joint6" type="hinge" axis="0 1 0" pos="0 0 0" range="-180 180"/>
                  <geom name="geom6" type="capsule" fromto="0 0 0 0 0 0.1" size="0.03"/>
                  <site name="ee" pos="0 0 0.1" size="0.02"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="a1" joint="joint1" kp="200"/>
    <position name="a2" joint="joint2" kp="200"/>
    <position name="a3" joint="joint3" kp="200"/>
    <position name="a4" joint="joint4" kp="200"/>
    <position name="a5" joint="joint5" kp="200"/>
    <position name="a6" joint="joint6" kp="200"/>
  </actuator>
  <visual>
    <map znear="0.01"/>
    <global offwidth="800" offheight="600"/>
    <camera name="cam" pos="0 -1 0.6" xyaxes="1 0 0 0 0 1"/>
  </visual>
</mujoco>
